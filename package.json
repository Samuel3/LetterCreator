{
  "name": "LetterCreator",
  "version": "1.1.1",
  "license": "MIT",
  "description": "A simple app to create business letters",
  "author": "Samuel Mathes <samuel.mathes@gmail.com>",
  "main": "./app/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "npm install && electron ./app",
    "pack": "electron-builder --dir",
    "prerelease": "node build/prebuild.js",
    "test": "mocha test/**/*.test.js --timeout 5000",
    "test:unit": "mocha test/**/*.test.js --timeout 5000",
    "test:e2e": "mocha test/spec.js --timeout 300000",
    "test:all": "mocha test/**/*.test.js test/spec.js --timeout 300000",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "LetterCreator",
    "icon": "build/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "Samuel3",
      "repo": "LetterCreator"
    },
    "nsis": {
      "perMachine": true
    },
    "win": {
      "publish": [
        "github"
      ],
      "target": "nsis",
      "fileAssociations": {
        "ext": "let",
        "name": "LetterCreator"
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-log": "^2.2.17",
    "electron-updater": "^4.0.0",
    "npm": "^6.7.0"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^25.1.8",
    "mocha": "^5.2.0",
    "spectron": "^3.8.0"
  }
}
